SESSION_SECRET=change-me-in-production-use-32-plus-chars
VAULT_KEY=change-me-in-production-use-32-plus-chars
# Must match the `issuer` in the discovery document (no trailing slash).
# Prod: https://auth.haelp.dev/api/auth
AUTH_ISSUER=http://localhost:5170/api/auth
AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
PUBLIC_BASE_URL=https://secrets.haelp.dev
# Created by an admin in auth under Admin / Clients
AUTH_CLIENT_ID=secrets
AUTH_CLIENT_SECRET=
ADDRESS_HEADER=cf-connecting-ip
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
ORIGIN=https://secrets.haelp.dev
